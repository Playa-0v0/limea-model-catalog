{
  "name": "@limea/model-catalog",
  "version": "0.1.0",
  "description": "离线可用的模型元数据与能力解析层（openai / anthropic / glm / kimi / deepseek / 豆包 Seed / 阿里 / 小米 / minimax / gemini / xai）",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/generated/catalog.d.ts",
      "import": "./dist/generated/catalog.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Playa-0v0/limea-model-catalog.git"
  },
  "keywords": [
    "ai",
    "llm",
    "model-catalog",
    "models.dev",
    "ai-sdk",
    "tool-calling",
    "capabilities"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "build:catalog": "node scripts/build-catalog.ts",
    "refresh:catalog": "node scripts/build-catalog.ts --refresh",
    "validate": "node scripts/validate.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
